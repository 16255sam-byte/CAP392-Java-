            }
        }
    }
    return{};
        
    }
};


class Foo {
public:
mutex m ;
condition_variable cv;
int count = 0;
    Foo() {
        
    }

    void first(function<void()> printFirst) {
        
        unique_lock<mutex> lock(m);
        printFirst();
        count = 1;

        cv.notify_all();
    }

    void second(function<void()> printSecond) {
        
         unique_lock<mutex> lock(m);
         cv.wait(lock,[this]{
            return count == 1;
         });
        printSecond();
        count =2;

        cv.notify_all();
    }

    void third(function<void()> printThird) {
         unique_lock<mutex> lock(m);
         cv.wait(lock,[this]{
            return count ==2;
         });
      
        printThird();
    }
};



